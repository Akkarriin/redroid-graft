+// PIDs may exceed the historical 32768 limit. Grow a packed bitmap to the
+// highest PID actually observed: O(1) lookup, no fixed pid_max assumption, and
+// only about 512 KiB per set even at Linux's current 4M PID ceiling.
+class pid_set {
+public:
+    bool count(pid_t pid) const {
+        if (pid <= 0) return false;
+        const size_t word = static_cast<size_t>(pid) / 64;
+        const uint64_t bit = uint64_t{1} << (pid % 64);
+        return word < words.size() && (words[word] & bit);
+    }
+
+    void insert(pid_t pid) {
+        if (pid <= 0) return;
+        const size_t word = static_cast<size_t>(pid) / 64;
+        if (word >= words.size()) words.resize(word + 1);
+        words[word] |= uint64_t{1} << (pid % 64);
+    }
+
+    void erase(pid_t pid) {
+        if (pid <= 0) return;
+        const size_t word = static_cast<size_t>(pid) / 64;
+        if (word < words.size()) words[word] &= ~(uint64_t{1} << (pid % 64));
+    }
+
+    void clear() {
+        for (auto &word : words) word = 0;
+    }
+
 private:
-    bitset<PID_MAX> set;
+    vector<uint64_t> words;
 };
 
